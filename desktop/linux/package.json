{
  "name": "orbit-linux-desktop",
  "version": "1.0.11",
  "author": "YUNSH",
  "desktopName": "top.orbit.desktop",
  "private": true,
  "description": "Orbit local AI desktop app for Linux",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "top.orbit.desktop",
    "productName": "Orbit",
    "artifactName": "Orbit-Linux-${arch}.${ext}",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../install.sh",
        "to": "install.sh"
      },
      {
        "from": "../../orbit/static/orbit-logo.png",
        "to": "orbit-logo.png"
      },
      {
        "from": "../../orbit/static/orbit-logo-transparent.png",
        "to": "orbit-logo-transparent.png"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "../../orbit/static/orbit-logo.png"
    }
  }
}
