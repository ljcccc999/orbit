<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><AssemblyName>Orbit</AssemblyName>
    <RootNamespace>OrbitDesktop</RootNamespace><Version>0.6.19</Version>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../install.ps1" LogicalName="OrbitDesktop.install.ps1" />
    <EmbeddedResource Include="../../orbit/static/orbit-logo.png" LogicalName="OrbitDesktop.orbit-logo.png" />
    <EmbeddedResource Include="../../orbit/static/orbit-logo-transparent.png" LogicalName="OrbitDesktop.orbit-logo-transparent.png" />
  </ItemGroup>
</Project>
